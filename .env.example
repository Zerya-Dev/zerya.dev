# Development uses Cloudflare test keys. Set Resend to send mail locally.
# https://resend.com/api-keys — verify zerya.dev in Resend.
NUXT_RESEND_API_KEY=re_xxx

# Production: create an invisible Turnstile widget for zerya.dev.
# https://dash.cloudflare.com/?to=/:account/turnstile
# The public key is embedded in the prerendered page during build.
# Both values are required by docker compose.
NUXT_PUBLIC_TURNSTILE_SITE_KEY=
NUXT_TURNSTILE_SECRET_KEY=

# Optional delivery and CAPTCHA hostname overrides.
# {tag} is replaced with the form source, e.g. contact+hero@zerya.dev.
# NUXT_CONTACT_TO=contact+{tag}@zerya.dev
# NUXT_CONTACT_FROM="Zerya Web <formularz@zerya.dev>"
# NUXT_CONTACT_ALLOWED_HOSTNAMES='["zerya.dev","www.zerya.dev"]'
# Exact socket IPs of trusted proxies as a JSON array. Unset trusts no proxy.
# Each trusted proxy must overwrite X-Forwarded-For with the client's IP.
# NUXT_CONTACT_TRUSTED_PROXY_IPS='["172.18.0.1"]'
