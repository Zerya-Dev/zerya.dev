# https://resend.com/api-keys - domain zerya.dev must be verified in Resend.
NUXT_RESEND_API_KEY=re_xxx
# https://dash.cloudflare.com/?to=/:account/turnstile - invisible widget for zerya.dev.
# The site key is baked in at build time (prerendered page). `bun dev` falls back to
# Cloudflare's always-pass test keys, so these are only needed for builds.
# NUXT_PUBLIC_TURNSTILE_SITE_KEY=
# NUXT_TURNSTILE_SECRET_KEY=
# Optional overrides ({tag} is replaced with the form source, e.g. contact+hero@zerya.dev)
# NUXT_CONTACT_TO=contact+{tag}@zerya.dev
# NUXT_CONTACT_FROM="Zerya Web <formularz@zerya.dev>"
