{
  "name": "zerya-websites",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.12.1",
  "scripts": {
    "build": "pnpm --recursive --workspace-concurrency=1 --filter './apps/*' run build",
    "company:build": "pnpm --filter '@zerya/company' run build",
    "company:dev": "pnpm --filter '@zerya/company' run dev",
    "company:preview": "pnpm --filter '@zerya/company' run preview",
    "company:typecheck": "pnpm --filter '@zerya/company' run typecheck",
    "dev": "pnpm --recursive --parallel --filter './apps/*' run dev",
    "foundation:build": "pnpm --filter '@zerya/foundation' run build",
    "foundation:dev": "pnpm --filter '@zerya/foundation' run dev",
    "foundation:preview": "pnpm --filter '@zerya/foundation' run preview",
    "foundation:typecheck": "pnpm --filter '@zerya/foundation' run typecheck",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "prepare": "vp config",
    "preview": "pnpm --recursive --parallel --filter './apps/*' run preview",
    "ready": "vpr lint && vpr typecheck && vpr test && vpr build",
    "test": "pnpm --recursive --parallel --if-present --filter './apps/*' run test",
    "test:e2e": "pnpm --recursive --parallel --if-present --filter './apps/*' run test:e2e",
    "test:e2e:ui": "pnpm --recursive --parallel --if-present --filter './apps/*' run test:e2e:ui",
    "test:nuxt": "pnpm --recursive --parallel --if-present --filter './apps/*' run test:nuxt",
    "test:watch": "pnpm --recursive --parallel --if-present --filter './apps/*' run test:watch",
    "typecheck": "pnpm --recursive --workspace-concurrency=1 --filter './apps/*' run typecheck"
  },
  "devDependencies": {
    "@nustackjs/lint": "catalog:toolchain",
    "eslint": "catalog:toolchain",
    "typescript": "catalog:toolchain",
    "vite": "catalog:toolchain",
    "vite-plus": "catalog:toolchain"
  }
}
