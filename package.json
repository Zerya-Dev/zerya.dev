{
  "name": "zerya-websites",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "build": "vp run -r build",
    "dev": "vp run -r --parallel dev",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "prepare": "vp config",
    "preview": "vp run -r --parallel preview",
    "ready": "vp run lint && vp run typecheck && vp run test && vp run build",
    "test": "vp run -r test",
    "typecheck": "vp run -r typecheck"
  },
  "devDependencies": {
    "@nustackjs/lint": "catalog:toolchain",
    "eslint": "catalog:toolchain",
    "typescript": "catalog:toolchain",
    "vite": "catalog:toolchain",
    "vite-plus": "catalog:toolchain"
  }
}
